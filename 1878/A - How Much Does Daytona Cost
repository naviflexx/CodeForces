using namespace std;
 
#define ios ios::sync_with_stdio(0); cin.tie(0);
 
void solve(){
    int n, k; cin >> n >> k; 
    vector<int> a(n);
    bool present = 0;
    for(int i=0; i<n; i++){
        cin >> a[i];
        if(a[i]==k) present=1;
    }
    if(present==1) cout << "YES";
    else cout << "NO";
   
}
 
